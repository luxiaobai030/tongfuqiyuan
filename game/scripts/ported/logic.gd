var clip_go_cb := Callable()
var clip_play_cb := Callable()
var clip_stop_cb := Callable()
func clip_go(nm: String, t) -> void:
	if clip_go_cb.is_valid(): clip_go_cb.call(nm, int(t))
func clip_play(nm: String) -> void:
