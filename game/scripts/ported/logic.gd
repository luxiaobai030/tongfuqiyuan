func _num(x) -> float:
	if x is bool: return 1.0 if x else 0.0
	if x is String: return float(x) if x.is_valid_float() else 0.0
	if x == null: return 0.0
	if x is float or x is int: return float(x)
	return 0.0
## ActionScript 只有一种数字（双精度），Godot 里浮点数拼成字符串会带上「.0」：
## setv("money", _sub(V("money"), 500)) 之后 money_tishi 会变成「500.0文」。
## 所以加减乘除的结果只要是整数就转回整数（原版显示的是「500文」）。
func _tidy(x):
	if x is float and absf(x) < 1e15 and absf(x - roundf(x)) < 0.0001:
		return int(roundf(x))
	return x
func _snum(x) -> String:
	var t = _tidy(x)
	return t if t is String else str(t)
func _add(a, b):
	if a is String or b is String: return _snum(a) + _snum(b)
	if (a is int or a is float) and (b is int or b is float): return _tidy(a + b)
	return _tidy(_num(a) + _num(b))
func _sub(a, b): return _tidy(_num(a) - _num(b))
func _mul(a, b): return _tidy(_num(a) * _num(b))
func _div(a, b):
	var d := _num(b)
	return 0 if d == 0.0 else _tidy(_num(a) / d)
func _eq(a, b) -> bool:
	if a is String or b is String: return str(a) == str(b)
	return _num(a) == _num(b)
func _mod(a, b):
	var d := _num(b)
	return 0 if d == 0.0 else _tidy(_num(a) - floor(_num(a) / d) * d)
func _truth(x) -> bool:
	if x is bool: return x
	if x is String: return x != ""
	if x == null: return false
	return _num(x) != 0.0
func _ne(a, b) -> bool:
	if a is String or b is String: return str(a) != str(b)
	return _num(a) != _num(b)
func _lt(a, b):
	if a is String and b is String: return a < b
	return _num(a) < _num(b)
func _gt(a, b):
	if a is String and b is String: return a > b
	return _num(a) > _num(b)
func _le(a, b): return not _gt(a, b)
func _ge(a, b): return not _lt(a, b)
