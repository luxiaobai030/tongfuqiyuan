; 同福奇缘 · Godot 移植版
config_version=5

[application]
config/name="同福奇缘"
config/description="武林外传同福客栈 · Flash 原版移植"
; 窗口 / 任务栏图标。exe 自己那个图标是导出时嵌进去的（export_presets.cfg 的
; application/icon 指向 icon.ico），两个都由 tools/build_icon.py 从根目录的 图标.jpg 生成。
config/icon="res://icon.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
GameState="*res://autoload/game_state.gd"

[display]
window/size/viewport_width=800
window/size/viewport_height=600
; 手机版横着玩（原版画面就是横的）；桌面版不受影响。
window/handheld/orientation="landscape"
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 手机版要用的纹理压缩格式。开了这个，导入贴图时会多存一份 ETC2/ASTC
; 数据（桌面版导出时不会把它打进包里，所以 exe 不会变大）。
textures/vram_compression/import_etc2_astc=true

[importer_defaults]

; 背景大图按有损 webp 导入（原版的画面本来就是有损 webp，再无损存一遍会白白多占一倍体积）
texture={
"compress/mode": 1,
"compress/lossy_quality": 0.9
}
